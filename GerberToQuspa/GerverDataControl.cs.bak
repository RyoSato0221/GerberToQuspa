            //            pos.Offset(-offset.X, offset.Y);
            //            list.Add(new Point { X = pos.X, Y = pos.Y });
            //        }
            //    }
            //}
            return list;
        }
        public List<Point> GetPointsInRegion(DispenseCondition condition)
        {
            List<Point> list = new List<Point>();
            foreach (var item in SelectItems)
            {
                List<Point> buf = item.GeneratePoints(condition);
                if (buf != null)
                {
                    Point offset = ContentBounds.BottomLeft;
                    foreach (var pos in buf)
                    {
                        pos.Offset(-offset.X, offset.Y);
                        list.Add(new Point { X = pos.X, Y = pos.Y });
                    }
                }
            }
            return list;
        }

        public void SetSelectItems(Rect area)
        {
            SelectItems = new List<IDrawItem>();
            foreach (var item in DrawItems)
            {
                if (item is DrawLine || item is DrawArcLine)
                {
                    continue;
                }

                Rect rect = item.GetBounds();
                if (rect.IntersectsWith(area))
                {
                    SelectItems.Add(item);
                }
            }
        }
    }

    public class VisualHostGerver : FrameworkElement
    {
        private Visual _child;

        public void SetVisual(Visual visual)
        {
            if (_child != null)
            {
                RemoveVisualChild(_child);
                RemoveLogicalChild(_child);
            }

            _child = visual;

            if (_child != null)
            {
                AddVisualChild(_child);
                AddLogicalChild(_child);
            }
        }

        protected override int VisualChildrenCount => _child == null ? 0 : 1;

        protected override Visual GetVisualChild(int index)
        {
            if (_child == null || index != 0)
                throw new ArgumentOutOfRangeException();

            return _child;
        }
    }
}