<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:GerberToQuspa">
    <FontFamily x:Key="FluentIconsFont">/Assets/Fonts/#Segoe Fluent Icons</FontFamily>

    <local:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    <local:ClusterToBrushConverter x:Key="ClusterToBrushConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <local:DoubleToScaledConverter x:Key="XDisplayConverter" Scale="1000" />
    <local:OffsetMultiConverter x:Key="OffsetMultiConverter"/>
    <local:BooleanInvertConverter x:Key="BooleanInvertConverter"/>
    <local:EnumEqualsToCollapsedConverter x:Key="EnumEqualsToCollapsedConverter"/>
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    
    <!--#region 色の定義-->
    <!-- 基本の文字色 -->
    <SolidColorBrush Color="#E4000000" x:Key="Light/Fill Color/Text/Primary"  />
    <SolidColorBrush Color="#9E000000" x:Key="Light/Fill Color/Text/Secondary" />
    <SolidColorBrush Color="#72000000" x:Key="Light/Fill Color/Text/Tertiary" />
    <SolidColorBrush Color="#5C000000" x:Key="Light/Fill Color/Text/Disabled" />

    <!-- アクセント文字色 -->
    <SolidColorBrush Color="#FF003692" x:Key="Light/Fill Color/Accent Text/Primary"  />
    <SolidColorBrush Color="#FF002668" x:Key="Light/Fill Color/Accent Text/Secondary" />
    <SolidColorBrush Color="#FF2965CC" x:Key="Light/Fill Color/Accent Text/Tertiary" />
    <SolidColorBrush Color="#5C000000" x:Key="Light/Fill Color/Accent Text/Disabled" />

    <!-- 背景色がアクセントカラーの場合に使用する文字色 -->
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Fill Color/Text On Accent/Primary"  />
    <SolidColorBrush Color="#B3FFFFFF" x:Key="Light/Fill Color/Text On Accent/Secondary" />
    <SolidColorBrush Color="#B3FFFFFF" x:Key="Light/Fill Color/Text On Accent/Disabled" />
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Fill Color/Text On Accent/Selected Text" />

    <!-- コントロールアイテムの基本の背景色 -->
    <SolidColorBrush Color="#B3FFFFFF" x:Key="Light/Fill Color/Control/Default" />
    <SolidColorBrush Color="#80F9F9F9" x:Key="Light/Fill Color/Control/Secondary" />
    <SolidColorBrush Color="#4DF9F9F9" x:Key="Light/Fill Color/Control/Tertiary" />
    <SolidColorBrush Color="#C2F3F3F3" x:Key="Light/Fill Color/Control/Quarternary"  />
    <SolidColorBrush Color="#FFDADADA" x:Key="Light/Fill Color/Control/Disabled"  />
    <SolidColorBrush Color="#00FFFFFF" x:Key="Light/Fill Color/Control/Transparent"  />
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Fill Color/Control/Input Active"  />

    <!-- トグルタイプのコントロールの「オフ」状態に使用される背景色 -->
    <SolidColorBrush Color="#00FFFFFF" x:Key="Light/Fill Color/Control Alt/Transparent"  />
    <SolidColorBrush Color="#06000000" x:Key="Light/Fill Color/Control Alt/Secondary" />
    <SolidColorBrush Color="#0F000000" x:Key="Light/Fill Color/Control Alt/Tertiary" />
    <SolidColorBrush Color="#18000000" x:Key="Light/Fill Color/Control Alt/Quarternary" />
    <SolidColorBrush Color="#00FFFFFF" x:Key="Light/Fill Color/Control Alt/Disabled" />

    <!-- スライダーのコントロールハンドラーの背景色 -->
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Fill Color/Control Solid/Default"  />

    <!-- コントロール比3:1の要件を満たす必要があるコントロールアイテムの背景色 -->
    <SolidColorBrush Color="#72000000" x:Key="Light/Fill Color/Control Strong/Default" />
    <SolidColorBrush Color="#51000000" x:Key="Light/Fill Color/Control Strong/Disabled" />

    <!-- 静止状態では透明で、インタラクションによって表示されるリストや項目の塗りつぶし色 -->
    <SolidColorBrush Color="#00000000" x:Key="Light/Fill Color/Subtle/Transparent"  />
    <SolidColorBrush Color="#FFDEEAFF" x:Key="Light/Fill Color/Subtle/Secondary" />
    <SolidColorBrush Color="#0A0A2C66" x:Key="Light/Fill Color/Subtle/Tertiary" />
    <SolidColorBrush Color="#00000000" x:Key="Light/Fill Color/Subtle/Disabled" />

    <!-- コントロールアイテムのアクセント背景色 -->
    <SolidColorBrush Color="#FF266EE9" x:Key="Light/Fill Color/Accent/Default" />
    <SolidColorBrush Color="#E6266EE9" x:Key="Light/Fill Color/Accent/Secondary" />
    <SolidColorBrush Color="#CC266EE9" x:Key="Light/Fill Color/Accent/Tertiary" />
    <SolidColorBrush Color="#37000000" x:Key="Light/Fill Color/Accent/Disabled" />
    <SolidColorBrush Color="#FF004ED4" x:Key="Light/Fill Color/Accent/Selected Text Background" />

    <!-- コントロールアイテムの枠線 -->
    <LinearGradientBrush x:Key="Light/Elevation/Control/Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E000000" Offset="0.91"/>
        <GradientStop Color="#1C000000" Offset="1.00"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Light/Elevation/Circle/Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F000000" Offset="0.50"/>
        <GradientStop Color="#29000000" Offset="0.95"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Light/Elevation/Text Control/Border"  StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F000000" Offset="0.97"/>
        <GradientStop Color="#72000000" Offset="0.97"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Light/Elevation/Text Control/Border Focused" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F000000" Offset="0.94"/>
        <GradientStop Color="#FF266EE9" Offset="0.94"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Light/Elevation/Accent Control/Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0.91"/>
        <GradientStop Color="#66000000" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- 基本の枠線、罫線 -->
    <SolidColorBrush Color="#FFE1E3E5" x:Key="Light/Stroke Color/Control Stroke/Default"  />
    <SolidColorBrush Color="#29000000" x:Key="Light/Stroke Color/Control Stroke/Secondary" />

    <!-- アクセントとなるパーツの枠線 -->
    <SolidColorBrush Color="#14FFFFFF" x:Key="Light/Stroke Color/Control Stroke/On Accent Default"  />
    <SolidColorBrush Color="#66000000" x:Key="Light/Stroke Color/Control Stroke/On Accent Secondary" />
    <SolidColorBrush Color="#37000000" x:Key="Light/Stroke Color/Control Stroke/On Accent Tertiary" />
    <SolidColorBrush Color="#0F000000" x:Key="Light/Stroke Color/Control Stroke/On Accent Disabled" />

    <!-- コントラスト比3:1の要件を満たす必要があるコントロールアイテムの枠線 -->
    <SolidColorBrush Color="#9C000000" x:Key="Light/Stroke Color/Control Strong Stroke/Default" />
    <SolidColorBrush Color="#37000000" x:Key="Light/Stroke Color/Control Strong Stroke/Disabled" />

    <!-- カードの枠線 -->
    <SolidColorBrush Color="#0F000000" x:Key="Light/Stroke Color/Card Stroke/Default" />
    <SolidColorBrush Color="#FFEBEBEB" x:Key="Light/Stroke Color/Card Stroke/Default Solid" />

    <!-- surfaces, dialogsなどの枠線 -->
    <SolidColorBrush Color="#66757575" x:Key="Light/Stroke Color/Surface Stroke/Default" />
    <SolidColorBrush Color="#0F000000" x:Key="Light/Stroke Color/Surface Stroke/Flyout" />

    <!-- 罫線 -->
    <SolidColorBrush Color="#0F000000" x:Key="Light/Stroke Color/Divider Stroke/Default" />

    <!-- キーボードフォーカスを持つUIの視覚的アクセシビリティに使用される枠線 -->
    <SolidColorBrush Color="#E4000000" x:Key="Light/Stroke Color/Focus Stroke/Outer" />
    <SolidColorBrush Color="#B3FFFFFF" x:Key="Light/Stroke Color/Focus Stroke/Inner" />

    <!-- カードの背景色 -->
    <SolidColorBrush Color="#FFFCFCFC" x:Key="Light/Background/Fill Color/Card Background/Default"  />
    <SolidColorBrush Color="#80F6F6F6" x:Key="Light/Background/Fill Color/Card Background/Secondary"  />
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Background/Fill Color/Card Background/Tertiary" />
    <SolidColorBrush Color="#FFF5F7FA" x:Key="Light/Background/Fill Color/Card Background/Accent" />

    <!-- ダイアログ表示時に使用するオーバーレイの背景色 -->
    <SolidColorBrush Color="#4D000000" x:Key="Light/Background/Fill Color/Smoke/Default" />

    <!-- レイヤーとして上に重ねるパーツの背景色 -->
    <SolidColorBrush Color="#80FFFFFF" x:Key="Light/Background/Fill Color/Layer/Default"/>
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Background/Fill Color/Layer/Alt"/>

    <!-- タブの背景色 -->
    <SolidColorBrush Color="#B3FFFFFF" x:Key="Light/Background/Fill Color/Layer On Mica Base Alt/Default"/>
    <SolidColorBrush Color="#FFF9F9F9" x:Key="Light/Background/Fill Color/Layer On Mica Base Alt/Tertiary"/>
    <SolidColorBrush Color="#00FFFFFF" x:Key="Light/Background/Fill Color/Layer On Mica Base Alt/Transparent"/>
    <SolidColorBrush Color="#0A000000" x:Key="Light/Background/Fill Color/Layer On Mica Base Alt/Secondary"/>

    <!-- 基本の背景色。カードやコントロールアイテムの背景色としても使用 -->
    <SolidColorBrush Color="#FFF3F3F3" x:Key="Light/Background/Fill Color/Solid Background/Base"/>
    <SolidColorBrush Color="#FFDADADA" x:Key="Light/Background/Fill Color/Solid Background/Base Alt"/>
    <SolidColorBrush Color="#FFEEEEEE" x:Key="Light/Background/Fill Color/Solid Background/Secondary"/>
    <SolidColorBrush Color="#FFF7F8FA" x:Key="Light/Background/Fill Color/Solid Background/Tertiary"/>
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Background/Fill Color/Solid Background/Quarternary"/>
    <SolidColorBrush Color="#FFFDFDFD" x:Key="Light/Background/Fill Color/Solid Background/Quinary"/>
    <SolidColorBrush Color="#FFFFFFFF" x:Key="Light/Background/Fill Color/Solid Background/Senary"/>

    <!-- 選択時などアクセントとなる際の背景色 -->
    <SolidColorBrush Color="#FFDBE8FF" x:Key="Light/Background/Fill Color/Accent Acrylic Background/Base"/>
    <SolidColorBrush Color="#FFEBF2FF" x:Key="Light/Background/Fill Color/Accent Acrylic Background/secondary"/>

    <!-- System Foreground -->
    <SolidColorBrush Color="#FF005FB7" x:Key="Light/Fill Color/System/Attention"/>
    <SolidColorBrush Color="#FF198925" x:Key="Light/Fill Color/System/Success"/>
    <SolidColorBrush Color="#FF9D5D00" x:Key="Light/Fill Color/System/Caution"/>
    <SolidColorBrush Color="#FFC42B1C" x:Key="Light/Shell/Fill Color/Caption Control Close Fill/Primary"/>
    <!--Light/Fill Color/System/Criticalと同じ-->
    <SolidColorBrush Color="#FFC42B1C" x:Key="Light/Fill Color/System/Critical"/>
    <SolidColorBrush Color="#FF844FC8" x:Key="Light/Fill Color/System/Accent"/>
    <SolidColorBrush Color="#72000000" x:Key="Light/Fill Color/System/Neutral"/>
    <SolidColorBrush Color="#FF8A8A8A" x:Key="Light/Fill Color/System/Solid Neutral"/>

    <!-- System Background -->
    <SolidColorBrush Color="#80DDEAF6" x:Key="Light/Fill Color/System/Attention Background"/>
    <SolidColorBrush Color="#FFDFF6DD" x:Key="Light/Fill Color/System/Success Background"/>
    <SolidColorBrush Color="#FFFFF4CE" x:Key="Light/Fill Color/System/Caution Background"/>
    <SolidColorBrush Color="#FFFDE7E9" x:Key="Light/Fill Color/System/Critical Background"/>
    <SolidColorBrush Color="#FFF1E7FD" x:Key="Light/Fill Color/System/Accent Background"/>
    <SolidColorBrush Color="#06000000" x:Key="Light/Fill Color/System/Neutral Background"/>
    <SolidColorBrush Color="#FFF3F3F3" x:Key="Light/Fill Color/System/Solid Neutral Background"/>
    <SolidColorBrush Color="#FFECEDEE" x:Key="Light/Fill Color/System/Solid Attention Background"/>
    <SolidColorBrush Color="#FFFFB200" x:Key="Light/Fill Color/System/Cution Custom"/>
    <!--#endregion-->

    <!--#region 文字フォントの定義-->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <!--Body タイポグラフィー-->
    <!--タイポグラフィーのスタイル（DataGridヘッダー、Label等に共用可能）-->
    <Style x:Key="Body_Control" TargetType="Control">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <!--TextBlock 専用タイポグラフィー-->
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="Body_Regular20" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <!--BodyStrong タイポグラフィー-->
    <!--タイポグラフィーのスタイル（DataGridヘッダー、Label等に共用可能）-->
    <Style x:Key="BodyStrong_Control" TargetType="Control">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!--TextBlock 専用タイポグラフィー-->
    <Style x:Key="BodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="BodyLargeStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="LineHeight" Value="52"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="68"/>
        <Setter Property="LineHeight" Value="92"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="IconSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="IconStandard" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="IconLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <!--#endregion-->

    <!--スタンダードボタンベース-->
    <Style x:Key="StandardButton" TargetType="Button">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Control/Border}"/>
        <Setter Property="BorderThickness" Value="1"/>       
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control/Secondary}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Control/Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Text On Accent/Selected Text}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Secondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Stroke/Default}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Text On Accent/Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Stroke/Default}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--スタンダード/アイコン/ボタン-->
    <Style x:Key="StandardIconButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <TextBlock Style="{StaticResource IconSmall}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!---スタンダード/テキスト/ボタン-->
    <Style x:Key="StandardTextButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Style="{StaticResource Body}" Text="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!---アイコン/ボタン-->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Style="{StaticResource IconLarge}" Text="{TemplateBinding Tag}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--アクセントボタンべース-->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Default}" />
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Accent Control/Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Secondary}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Accent Control/Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Tertiary}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text On Accent/Secondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Stroke/On Accent Default}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text On Accent/Disabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Accent Control/Border}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!---アクセント/アイコン/ボタン-->
    <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Style="{StaticResource IconLarge}" Text="{TemplateBinding Tag}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!---アクセント/テキスト/ボタン-->
    <Style x:Key="AccentTextButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Style="{StaticResource Body}" Text="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--ウィンドウの外観-->
    <Style x:Key="WindowFrame" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFFFF"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Surface Stroke/Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- サブウィンドウタイトルバーのStyle -->
    <Style x:Key="SubTitleBarStyle" TargetType="ContentControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="10,10,0,0" BorderBrush="#23000000" BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource Light/Background/Fill Color/Solid Background/Base}">
                        <Grid>
                            <TextBlock Style="{StaticResource SubTitle}" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBoxスタイル -->
    <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="1,1,34,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}"/>
        <Setter Property="Background" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Text Control/Border}" />
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control/Input Active}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Text Control/Border Focused}" />
                <Setter Property="Padding" Value="0,0,33,0"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Text Control/Border Focused}" />
                <Setter Property="Padding" Value="0,0,33,0"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control/Disabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Elevation/Text Control/Border}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--テーブルスタイル-->
    <Style x:Key="DataTable" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Divider Stroke/Default}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserResizeColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Divider Stroke/Default}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Secondary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <TextBlock Text="{TemplateBinding Content}" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}">
                                    <StackPanel VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border CornerRadius="5,5,5,5" BorderThickness="0" Background="{StaticResource Light/Background/Fill Color/Accent Acrylic Background/secondary}" Margin="0,2,0,2">
                                            <StackPanel VerticalAlignment="Center">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!--選択状態-->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border BorderThickness="0" Background="{StaticResource Light/Background/Fill Color/Accent Acrylic Background/secondary}" Margin="0,2,0,2">
                                            <StackPanel VerticalAlignment="Center">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}}" Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Column.DisplayIndex}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border CornerRadius="5,0,0,5" Background="{StaticResource Light/Background/Fill Color/Accent Acrylic Background/Base}" Margin="0,2,0,2">
                                            <StackPanel VerticalAlignment="Center">
                                                <Canvas>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="0" Width="3" Height="20" Fill="{StaticResource Light/Fill Color/Accent/Default}" />
                                                </Canvas>
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--編集テーブルスタイル-->
    <Style x:Key="EditTable" TargetType="DataGrid" BasedOn="{StaticResource DataTable}">
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <!-- マウスホバー時の背景色を固定 -->
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ToggleSwitchスタイル-->
    <Style x:Key="ToggleSwitchStyle" TargetType="local:CustomToggleButton">
        <Setter Property="Height" Value="20"/>
        <Setter Property="OnText" Value="On"/>
        <Setter Property="OffText" Value="Off"/>
        <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Text/Secondary}"/>
        <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text/Secondary}"/>
        <Setter Property="ThumbMargin" Value="4,0,0,0"/>
        <Setter Property="ThumbWidth" Value="12"/>
        <Setter Property="ThumbHeight" Value="12"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CustomToggleButton">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Grid>
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Width="40" Height="20">
                                    <Ellipse x:Name="Thumb" Fill="{TemplateBinding InnerFill}"  StrokeThickness="1"  HorizontalAlignment="Left" 
                                             Width="{TemplateBinding ThumbWidth}" Height="{TemplateBinding ThumbHeight}" Margin="{TemplateBinding ThumbMargin}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="OffText" Text="{TemplateBinding OffText}" Margin="12,0,0,0" Visibility="Visible"/>
                            <TextBlock x:Name="OnText" Text="{TemplateBinding OnText}" Margin="12,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="OffText" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OnText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="OffText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OnText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Tertiary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
                <Setter Property="ThumbMargin" Value="2,0,0,0"/>
                <Setter Property="ThumbWidth" Value="14"/>
                <Setter Property="ThumbHeight" Value="14"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Tertiary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
                <Setter Property="ThumbMargin" Value="2,0,0,0"/>
                <Setter Property="ThumbWidth" Value="17"/>
                <Setter Property="ThumbHeight" Value="14"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Disabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="ThumbMargin" Value="0,0,4,0"/>
            </Trigger>
            <!--チェック有 & マウスオーバー-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="ThumbMargin" Value="0,0,2,0"/>
                <Setter Property="ThumbWidth" Value="14"/>
                <Setter Property="ThumbHeight" Value="14"/>
            </MultiDataTrigger>
            <!--チェック有 & 押し状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="ThumbMargin" Value="0,0,2,0"/>
                <Setter Property="ThumbWidth" Value="17"/>
                <Setter Property="ThumbHeight" Value="14"/>
            </MultiDataTrigger>
            <!--チェック有 & 無効状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Disabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="ThumbMargin" Value="0,0,4,0"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ContentMenu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- MenuItemのスタイル定義 -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>       
