    <!--CustomCheckBoxスタイル-->
    <Style x:Key="CustomCheckBoxStyle" TargetType="local:CustomCheckBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}"/>
        <Setter Property="CheckForeground" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CustomCheckBox">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20">
                                    <Grid>
                                        <TextBlock x:Name="CheckMark" Style="{StaticResource IconSmall}" Foreground="{TemplateBinding CheckForeground}" Text="&#xe73e;" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--非チェック時はチェックマークを非表示にする-->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Tertiary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Quarternary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Disabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Default}"/>
            </Trigger>
            <!--チェック有 & マウスオーバー-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
            </MultiDataTrigger>
            <!--チェック有 & 押し状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Accent/Tertiary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Fill Color/Accent/Tertiary}"/>
                <Setter Property="CheckForeground" Value="{StaticResource Light/Fill Color/Text On Accent/Secondary}"/>
            </MultiDataTrigger>
            <!--チェック有 & 無効状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Light/Fill Color/Control Alt/Disabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
                <Setter Property="CheckForeground" Value="{StaticResource Light/Fill Color/Text On Accent/Disabled}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- RadioButtonスタイル -->
    <Style x:Key="CuatomRadioButtonStyle" TargetType="local:CustomRadioButton">
        <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Primary}"/>
        <Setter Property="OuterBorder" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
        <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Control Alt/Secondary}"/>
        <Setter Property="InnerDiameter" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CustomRadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="{TemplateBinding OuterBorder}" Fill="{TemplateBinding OuterFill}" StrokeThickness="1"/>
                            <Ellipse Stroke="{TemplateBinding InnerBorder}" Fill="{TemplateBinding InnerFill}" StrokeThickness="1" Width="{TemplateBinding InnerDiameter}" Height="{TemplateBinding InnerDiameter}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource BodyLarge}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="OuterBorder" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Default}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Control Alt/Tertiary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="OuterBorder" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Control Alt/Quarternary}"/>
                <Setter Property="InnerBorder" Value="{StaticResource Light/Fill Color/Control Alt/Quarternary}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerDiameter" Value="8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
                <Setter Property="OuterBorder" Value="{StaticResource Light/Stroke Color/Control Strong Stroke/Disabled}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Control Alt/Disabled}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="OuterBorder" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
                <Setter Property="InnerBorder" Value="{StaticResource Light/Elevation/Circle/Border}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerDiameter" Value="8"/>
            </Trigger>
            <!--チェック有 & マウスオーバー-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="OuterBorder" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Accent/Secondary}"/>
                <Setter Property="InnerBorder" Value="{StaticResource Light/Elevation/Circle/Border}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerDiameter" Value="10"/>
            </MultiDataTrigger>
            <!--チェック有 & 押し状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="OuterBorder" Value="{StaticResource Light/Fill Color/Accent/Tertiary}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Accent/Tertiary}"/>
                <Setter Property="InnerBorder" Value="{StaticResource Light/Elevation/Circle/Border}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerDiameter" Value="6"/>
            </MultiDataTrigger>
            <!--チェック有 & 無効状態-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource Light/Fill Color/Text/Disabled}"/>
                <Setter Property="OuterBorder" Value="{StaticResource Light/Fill Color/Accent/Disabled}"/>
                <Setter Property="OuterFill" Value="{StaticResource Light/Fill Color/Accent/Disabled}"/>
                <Setter Property="InnerBorder" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerFill" Value="{StaticResource Light/Fill Color/Text On Accent/Primary}"/>
                <Setter Property="InnerDiameter" Value="8"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--Tabコントロールスタイル-->
    <Style x:Key="CustomTabStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Light/Background/Fill Color/Solid Background/Tertiary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Light/Stroke Color/Card Stroke/Default}"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
    </Style>
    
    <Style x:Key="SimpleTabItemStyle" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- タブの角を丸くする -->
                    <Border Name="Border" CornerRadius="8,8,0,0" Padding="16,4" Width="170"
                            Background="Transparent"
                            BorderThickness="1,1,1,0"
                            BorderBrush="{StaticResource Light/Stroke Color/Card Stroke/Default}">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Light/Background/Fill Color/Solid Background/Tertiary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Light/Background/Fill Color/Accent Acrylic Background/secondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- タブのヘッダーのフォントを設定 -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource Light/Fill Color/Text/Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <!-- タブが選択されたときのフォント設定 -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--コンボボックスのアイテムスタイル-->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border BorderBrush="Transparent" Background="Transparent" BorderThickness="1" Margin="5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ContentPresenter Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Background="{StaticResource Light/Background/Fill Color/Accent Acrylic Background/Base}" CornerRadius="3" Margin="5,3,5,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Canvas>
                                        <Rectangle Canvas.Left="4" Canvas.Top="0" Width="3" Height="20" Fill="{StaticResource Light/Fill Color/Accent/Default}" />
                                    </Canvas>
                                    <ContentPresenter Margin="17,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--ドロップダウンのみスタイル-->
    <Style x:Key="CustomDropDown" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- 外枠 -->
                        <Border Background="{StaticResource Light/Fill Color/Text On Accent/Primary}" BorderBrush="{StaticResource Light/Elevation/Control/Border}" BorderThickness="1" CornerRadius="3" />

                        <!-- 選択された項目表示 -->
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="5,0,30,0" VerticalAlignment="Center"/>

                        <!-- ドロップダウンボタン -->
                        <ToggleButton Name="DropDownToggle"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="false"
                                      ClickMode="Press"
                                      Width="32"
                                      Height="32"
                                      HorizontalAlignment="Right"
                                      Margin="0"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      >
                            <TextBlock Style="{StaticResource IconStandard}" Text="&#xe70d;"/>
                        </ToggleButton>

                        <!-- ドロップダウン内容 -->
                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{StaticResource Light/Background/Fill Color/Solid Background/Base}" BorderBrush="{StaticResource Light/Elevation/Control/Border}" BorderThickness="1" CornerRadius="7">
                                <ScrollViewer MaxHeight="300">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--カードのウィンドウスタイル-->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Light/Background/Fill Color/Card Background/Accent}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    
</ResourceDictionary>