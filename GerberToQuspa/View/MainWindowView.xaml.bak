<Window x:Class="GerverToQuspa.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GerverToQuspa"
        xmlns:view="clr-namespace:GerverToQuspa.View"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        mc:Ignorable="d"
        Title="PanSample" Height="1000" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        >
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="*"/>
            <ColumnDefinition Width ="550"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid x:Name="mainGrid" Grid.Row="0" Background="Black" ClipToBounds="True" SizeChanged="MainGrid_SizeChanged">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="塗布点追加" Command="{Binding AddDispenseCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xecc8;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="塗布点削除" Command="{Binding DeleteDispenseCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xe74d;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="塗布点オフセット" Command="{Binding OffsetDispenseCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xe7c2;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="指定領域でクラスタリング" Command="{Binding ClusteringCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xf168;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="フィット" Command="{Binding ResetViewCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xe9a6;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="指定領域で拡大表示" Command="{Binding AreaZoomCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xe8a3;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="現在座標を原点に設定する" Command="{Binding SetOriginPointCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource IconStandard}" Text="&#xe718;" Foreground="Black"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Canvas ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image Source="{Binding ImageSource}" Stretch="None"/>
                    <local:VisualHost x:Name="visualHost"/>
                </Canvas>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="現在座標(mm)" Style="{StaticResource BodyLarge}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentMouseWorldPosX, FallbackValue=X: 0.0000}" Style="{StaticResource BodyLarge}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBlock Text="{Binding CurrentMouseWorldPosY, FallbackValue=Y: 0.0000}" Style="{StaticResource BodyLarge}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="40,0">
                        <TextBlock Text="原点座標(mm)" Style="{StaticResource BodyLarge}" VerticalAlignment="Center"/>
                        <TextBlock Text="X:" Style="{StaticResource BodyLarge}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Style="{StaticResource CustomTextBoxStyle}" Margin="8,0,0,0" Width="110" Text="{Binding ViewOriginPointX, FallbackValue=0.0000, StringFormat=F4, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="1,1,24,1"/>
                        <TextBlock Text="Y:" Style="{StaticResource BodyLarge}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Style="{StaticResource CustomTextBoxStyle}" Margin="8,0,0,0" Width="110" Text="{Binding ViewOriginPointY, FallbackValue=0.0000, StringFormat=F4, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="1,1,24,1"/>
                        <Button Style="{StaticResource StandardIconButton}" Tag="&#xe777;" Height="32" Width="32" Command="{Binding ResetOriginCommand}" ToolTip="原点座標リセット" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Width="150">
                    <local:CustomToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ZoomSelect}" IsEnabled="{Binding IsEnableMapExchange}"
                                              OnText="拡大表示" OffText="全体表示" Margin="0,5,10,0"/>
                    <local:CustomToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding OriginView}" OnText="原点表示" OffText="原点非表示" Margin="0,10,10,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>
           
            <Grid Grid.Row="0" Margin="16">
                <TabControl Style="{StaticResource CustomTabStyle}" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabControl.ItemContainerStyle>
                        <StaticResource ResourceKey="SimpleTabItemStyle"/>
                    </TabControl.ItemContainerStyle>
                    <TabItem Header="座標データ">
                        <view:PointListView/>
                    </TabItem>
                    <TabItem Header="クラスタリングリスト">
                        <view:OperationOrderView DataContext="{Binding OperationOrderVM}"/>
                    </TabItem>
                    <TabItem Header="クラスタリング設定">
                        <view:ClusterSettingView DataContext="{Binding ClusterSettingViewModel}" />
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="塗布点の大きさ" Style="{StaticResource BodyLarge}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource CustomTextBoxStyle}" Margin="16,0,0,0" Width="75" Text="{Binding RenderContext.PointSize, FallbackValue=10, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="1,1,24,1"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Style="{StaticResource StandardIconButton}" Tag="&#xeb11;" Command="{Binding PointSizeUpCommand}"/>
                            <Button Style="{StaticResource StandardIconButton}" Tag="&#xeb0f;" Command="{Binding PointSizeDownCommand}" ToolTip="Fit"/>
                        </StackPanel>
                        <TextBlock Text="線幅" Style="{StaticResource BodyLarge}" Margin="48,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource CustomTextBoxStyle}" Margin="16,0,0,0" Width="75" Text="{Binding RenderContext.Thickness, FallbackValue=5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="1,1,24,1"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Style="{StaticResource StandardIconButton}" Tag="&#xeb11;" Command="{Binding ThicknessUpCommand}"/>
                            <Button Style="{StaticResource StandardIconButton}" Tag="&#xeb0f;" Command="{Binding ThicknessDownCommand}" ToolTip="Fit"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="0,5">
                        <StackPanel Orientation="Horizontal" >
                            <Button Style="{StaticResource AccentIconButton}" Tag="&#xe9a6;" Command="{Binding ResetViewCommand}" ToolTip="Fit"/>
                            <Button Style="{StaticResource AccentIconButton}" Tag="&#xe8e5;" Command="{Binding ReadGervarCommand}" ToolTip="ガーバーデータ読み込み"/>
                            <Button Style="{StaticResource AccentIconButton}" Tag="&#xf5b0;" Command="{Binding CreateRouteCommand}" ToolTip="経路作成" IsEnabled="{Binding IsEnableCreateRoute}"/>                            
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource AccentIconButton}" Tag="&#xe896;" Command="{Binding WhileDataInPortCommand}" ToolTip="ファイル入力"/>
                            <Button Style="{StaticResource AccentIconButton}" Tag="&#xe898;" Command="{Binding WhileDataExPortCommand}" ToolTip="ファイル出力" IsEnabled="{Binding IsEnableOutputFile}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</Window>